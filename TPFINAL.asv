%% Tp Final PDI

T = readtable('hemorrhage_diagnosis.csv');   % tabla: un renglon por corte
head(T)    % muestra SOLO los primeros renglones
conH = T(T.No_Hemorrhage == 0, :);   % solo los renglones donde SOLO hay hemorragia
conH(1:30 , {'PatientNumber', 'SliceNumber'}) ;  % paciente y corte de los primeros 10 con hemorragia
%% Primer corte con hemorragia de la lista
p = conH.PatientNumber(1);       % numero de paciente
s = conH.SliceNumber(1);         % numero de corte

%% ARCHIVOS
carpeta= fullfile('Patients_CT', sprintf('%03d', p));
Ibrain= imread(fullfile(carpeta, 'brain', sprintf('%d.jpg', s)));          % ventana de cerebro
Ihueso= imread(fullfile(carpeta, 'bone',  sprintf('%d.jpg', s)));          % ventana de hueso
M= imread(fullfile(carpeta, 'brain', sprintf('%d_HGE_Seg.jpg', s)));  % mascara de la hemorragia
M= M > 128;     

%% Muestro Imagenes
figure
subplot(1,3,1);
imshow(Ibrain);
title(sprintf('Paciente %d, corte %d', p, s));
subplot(1,3,2);
imshow(Ihueso);
title('Ventana de hueso');
subplot(1,3,3);
imshow(Ibrain)
hold on
visboundaries(M, 'Color', 'r');  
title('Hemorragia marcada');
%% 
size(Ibrain)                      
figure
imshow(Ibrain)
hold on
visboundaries(M, 'Color', 'r');    
impixelinfo         
%% segmentacion de hueso y cerebro y hemorragia
craneo  = Ibrain > 240;
cerrado = imclose(craneo, strel('disk', 15));  % tapa los huecos del anillo
disco   = imfill(cerrado, 'holes');
interior = disco & ~craneo;
interior = bwareafilt(interior, 1);
interior = imerode(interior, strel('disk', 2));
cerebro = Ibrain;  
cerebro(~interior) = 0;

figure
subplot(2,2,1);
imshow(craneo);
title('1) Hueso (>240)');
subplot(2,2,2);
imshow(disco);
title('2) Relleno');
subplot(2,2,3);
imshow(interior);
title('3) Interior')
subplot(2,2,4);
imshow(cerebro);
hold on
visboundaries(M, 'Color', 'r');
title('4) Cerebro sin cráneo + hemorragia')
% veo que porcentaje de la hemorragia quedo adentro de la mascara del
% cerebro:
porc = 100 * sum(M(:) & interior(:)) / sum(M(:))
%% Histograma: sangre vs cerebro sano
figure
histogram(cerebro(M & interior), 0:255, 'Normalization','pdf')
hold on
histogram(cerebro(~M & interior), 0:255, 'Normalization','pdf')
legend('Sangre','Cerebro sano');
xlabel('Nivel de gris');
%% Segmento sangre
cf = medfilt2(cerebro, [5 5]); 
sangre = (cf > 150) & (cf < 215) & interior; % rango de la sangre, solo adentro del cerebro
sangre = bwareaopen(sangre, 50);           % saco puntitos chicos
% Comparo con la máscara de los médicos (Dice: 1 = perfecto, 0 = nada)
dice = 2*sum(sangre(:) & M(:)) / (sum(sangre(:)) + sum(M(:)))

figure, imshow(Ibrain), hold on
visboundaries(M, 'Color', 'r')        % rojo = médicos
visboundaries(sangre, 'Color', 'g')   % verde = nuestro
%% Veo porque dice me dan tan chico s

nuestro = sum(sangre(:))
medicos = sum(M(:))
acierto = sum(sangre(:) & M(:))